rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Peserta Collection
    match /peserta/{pesertaId} {
      allow read: if true;
      allow write: if true;
    }

    // Delegasi Collection
    match /delegasi/{delegasiId} {
      allow read: if true;
      allow write: if true;
    }

    // Config & Anggaran Collection
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
